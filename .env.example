# Telegram bot tokeni (@BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API kaliti (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ishlatiladigan Claude modeli. Xarajatni kamaytirish uchun
# claude-sonnet-5 yoki claude-haiku-4-5 ga o'zgartirishingiz mumkin.
ANTHROPIC_MODEL=claude-opus-5

# Har bir javob uchun maksimal token soni (qisqa, ovozli o'qishga mos javoblar uchun past qiymat tavsiya etiladi)
ANTHROPIC_MAX_TOKENS=1024

# Modelning "fikrlash" chuqurligi: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# Har bir chat uchun xotirada saqlanadigan oxirgi xabarlar soni
MAX_HISTORY_MESSAGES=20

# Log darajasi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
